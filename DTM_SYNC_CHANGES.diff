+class TestBuildingGridSemantics(unittest.TestCase):
+    @staticmethod
+    def _raw(*, x=5, y=5, picture=0, variant=0, typ=1, sx=2, sy=2):
+        raw = bytearray(qs.BUILDING_SIZE)
+        struct.pack_into('<HH', raw, 0, x, y)
+        raw[4] = picture
+        raw[5] = variant
+        raw[6] = typ
+        raw[289] = sx
+        raw[290] = sy
+        return bytes(raw)
+
+    def test_picture_change_requires_grid_rebuild(self):
+        old = self._raw(picture=1, variant=0)
+        new = self._raw(picture=1, variant=1)
+        self.assertTrue(qs._building_grid_semantics_changed(old, new))
+
+    def test_type_change_requires_grid_rebuild(self):
+        old = self._raw(typ=1)
+        new = self._raw(typ=3)
+        self.assertTrue(qs._building_grid_semantics_changed(old, new))
+
+    def test_unrelated_building_byte_does_not_require_grid_rebuild(self):
+        old = bytearray(self._raw())
+        new = bytearray(old)
+        new[337] = 2  # group: semantic runtime change, not footprint geometry
+        self.assertFalse(qs._building_grid_semantics_changed(bytes(old), bytes(new)))
+
